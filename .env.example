# Vercel 배포 시 프로젝트 환경 변수에 등록하고, 로컬에서 `vercel dev`로 api/ 함수를 테스트하려면
# 이 파일을 .env로 복사한 뒤 값을 채워 넣으세요.
# https://aistudio.google.com 에서 무료로 발급 가능 (AIza로 시작)
GEMINI_API_KEY=

# 구글 캘린더 자동 동기화 (Google Cloud Console > OAuth 클라이언트 ID, 웹 애플리케이션)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Cloud Console의 "승인된 리디렉션 URI"에 등록한 값과 정확히 같아야 합니다.
# 로컬(vercel dev)에서는 보통 http://localhost:3000/api/auth/google-callback
GOOGLE_REDIRECT_URI=
# 연동 완료 후 사용자를 돌려보낼 앱 주소 (로컬은 http://localhost:3000, 배포 후에는 실제 도메인)
APP_BASE_URL=

# Vercel KV (Vercel 대시보드에서 프로젝트에 KV 스토리지를 추가하면 자동으로 채워집니다.
# `vercel env pull .env`로 로컬에 받아오면 직접 입력할 필요 없어요.)
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
